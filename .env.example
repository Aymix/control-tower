# Postgres (docker compose exposes 5433 on the host)
DATABASE_URL=postgres://tower:tower@localhost:5433/tower

# Public URL of the app (used by Better Auth for passkey RP id/origin)
APP_URL=http://localhost:3000

# 32 random bytes, base64 — encrypts workspace PATs at rest (AES-256-GCM)
# generate: openssl rand -base64 32
MASTER_KEY=

# Better Auth secret — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required in production to create the first (owner) account at /setup
SETUP_TOKEN=

# Dev only: enables POST /api/auth/dev/login { userId }. Ignored when NODE_ENV=production.
DEV_LOGIN=0

# Worker: PR polling cadence (seconds)
PR_POLL_HOT_SECONDS=60
PR_POLL_WARM_SECONDS=300
PR_POLL_COLD_SECONDS=1800

# Production only (docker-compose.prod.yml)
# DOMAIN=tower.example.com
# POSTGRES_PASSWORD=

# Claude sessions (phase 2)
SESSION_MAX_HOURS=6          # reaper interrupts and fails sessions running longer than this
SESSION_SILENT_MINUTES=5     # reaper fails sessions whose runner stopped heartbeating
RUNNER_OFFLINE_SECONDS=90    # runner shows Offline after this long without a poll
